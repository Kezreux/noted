<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="noted"
        Arguments=""
        InstallLocation="C:\Program Files\Kezreux\noted">
    </Installer>
    <PackageInformation
        PackageName="noted"
        PackageDisplayName="noted"
        PublisherName="CN=Kezreux"
        PublisherDisplayName="Kezreux"
        Version="0.1.0.0"
        PackageDescription="An offline logbook for a technical electronics test environment">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="dev.kezreux.noted"
                Description="An offline logbook for a technical electronics test environment"
                DisplayName="noted"
                ExecutableName="noted"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>noted</DisplayName>
            <PublisherDisplayName>Kezreux</PublisherDisplayName>
            <Description>An offline logbook for a technical electronics test environment</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="noted.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
